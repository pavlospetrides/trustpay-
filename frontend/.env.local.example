# Copy to .env.local in this directory. Never commit .env.local.
# Default: fully local synthetic SQLite mode.
TRUSTPAY_BACKEND=sqlite
TRUSTPAY_DB_PATH=data/trustpay.sqlite3

# Designated Supabase development mode only: set TRUSTPAY_BACKEND=postgres.
TRUSTPAY_DATABASE_URL=
# Download this project's CA certificate from Supabase and use an absolute path.
TRUSTPAY_DATABASE_CA_CERT_PATH=
TRUSTPAY_DB_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Two distinct random 32-byte values encoded with base64. Preserve existing keys for existing ciphertext.
TRUSTPAY_IBAN_ENCRYPTION_KEY=
TRUSTPAY_IBAN_FINGERPRINT_KEY=

# Optional external AI for synthetic development documents only.
TRUSTPAY_ENVIRONMENT=development
OPENAI_API_KEY=
TRUSTPAY_AI_MODEL=gpt-5.4-mini
TRUSTPAY_AI_EXTERNAL_DOCUMENTS=disabled

# Opt-in hosted smoke and Playwright checks against a designated development project.
TRUSTPAY_E2E_BASE_URL=http://127.0.0.1:3000
TRUSTPAY_E2E_MAKER_ORG=
TRUSTPAY_E2E_OUTSIDER_ORG=
TRUSTPAY_E2E_MAKER_EMAIL=
TRUSTPAY_E2E_MAKER_PASSWORD=
TRUSTPAY_E2E_VERIFIER_EMAIL=
TRUSTPAY_E2E_VERIFIER_PASSWORD=
TRUSTPAY_E2E_APPROVER_EMAIL=
TRUSTPAY_E2E_APPROVER_PASSWORD=
TRUSTPAY_E2E_OUTSIDER_EMAIL=
TRUSTPAY_E2E_OUTSIDER_PASSWORD=
