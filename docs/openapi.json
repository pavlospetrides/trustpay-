  "components": {
    "schemas": {
      "AssessmentInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "supplier_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Supplier Id"
          },
          "invoice_number": {
            "type": "string",
            "maxLength": 70,
            "minLength": 2,
            "title": "Invoice Number"
          },
          "amount_cents": {
            "type": "integer",
            "maximum": 100000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          },
          "creditor_account": {
            "type": "string",
            "maxLength": 64,
            "minLength": 4,
            "title": "Creditor Account"
          },
          "invoice_date": {
            "type": "string",
            "format": "date",
            "title": "Invoice Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "supplier_id",
          "invoice_number",
          "amount_cents",
          "creditor_account",
          "invoice_date"
        ],
        "title": "AssessmentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationInput": {
        "properties": {
          "evidence_note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 12,
            "title": "Evidence Note"
          }
        },
        "type": "object",
        "required": [
          "evidence_note"
        ],
        "title": "VerificationInput"
      }
    }
  }
