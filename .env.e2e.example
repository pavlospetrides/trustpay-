# Copy to .env.e2e (git-ignored) for the opt-in hosted tests in tests/hosted/. Never commit real passwords.
# Personas are test steps, not app roles. Each needs a real Supabase Auth user with the stated membership:
#   MAKER    uploads and analyzes   -> analyst, admin or owner in Org A
#   VERIFIER independent check      -> analyst, admin or owner in Org A, and not the maker
#   APPROVER internal approval      -> approver, admin or owner in Org A, and not the maker or verifier
#   OUTSIDER another company        -> member of Org B ONLY (tenant-isolation checks)
TRUSTPAY_E2E_PROJECT_REF=dtoqrscbbdacqpaqxgpr
TRUSTPAY_E2E_MAKER_ORG=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
TRUSTPAY_E2E_OUTSIDER_ORG=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
TRUSTPAY_E2E_MAKER_EMAIL=
TRUSTPAY_E2E_MAKER_PASSWORD=
TRUSTPAY_E2E_VERIFIER_EMAIL=
TRUSTPAY_E2E_VERIFIER_PASSWORD=
TRUSTPAY_E2E_APPROVER_EMAIL=
TRUSTPAY_E2E_APPROVER_PASSWORD=
TRUSTPAY_E2E_OUTSIDER_EMAIL=
TRUSTPAY_E2E_OUTSIDER_PASSWORD=
