# Copy to .env for local development; never commit .env.
TRUSTPAY_BACKEND=sqlite
TRUSTPAY_DB_PATH=data/trustpay.sqlite3

# For an explicitly designated Supabase development project, set TRUSTPAY_BACKEND=postgres.
# FastAPI reuses up to TRUSTPAY_DB_POOL_SIZE connections (default 5); each holds one Supabase session-pooler slot.
TRUSTPAY_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TRUSTPAY_IBAN_ENCRYPTION_KEY=
TRUSTPAY_IBAN_FINGERPRINT_KEY=

# Optional Phase 2 reader for synthetic development documents only.
# Enabling external document processing requires all three settings below.
OPENAI_API_KEY=
TRUSTPAY_AI_MODEL=gpt-5.4-mini
TRUSTPAY_AI_EXTERNAL_DOCUMENTS=disabled

# Used only by the manual synthetic seed command.
TRUSTPAY_ENVIRONMENT=development
TRUSTPAY_SEED_CONFIRM=
TRUSTPAY_DEMO_OWNER_ID=
TRUSTPAY_DEMO_ANALYST_ID=
TRUSTPAY_DEMO_APPROVER_ID=
